# ==============================================================================
# YAVQEN — Environment Configuration Template
# YAVQEN reads environment variables only; it does not load .env by itself. Copy this file to .env,
# fill it in, and export it before starting the server:  set -a; . ./.env; set +a
# All PayPal endpoints strictly target the PayPal Developer Sandbox environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# PayPal Developer Platform (Sandbox Only)
# Create a free Sandbox REST App at: https://developer.paypal.com/dashboard/applications/sandbox
# Note: If left empty, YAVQEN automatically runs with a deterministic PayPal
# Sandbox REST protocol simulator so demos and tests work out of the box.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# AI Contract Compiler & Deliverable Auditor Configuration (Optional)
# Provide either a Google Gemini API key or an OpenAI/Groq-compatible API key.
# Note: If no AI key is provided, the agreed tests still run, a custom agreement gets a heuristic
# (non-AI) draft, and AI-judged criteria go to a person (NEEDS_HUMAN_REVIEW).
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Local open-weight model instead (no key, no cost): ollama pull gpt-oss:20b, then
# OPENAI_API_KEY=ollama  OPENAI_BASE_URL=http://localhost:11434/v1  AI_MODEL=gpt-oss:20b
# empty = the provider's default (gemini-2.5-flash with GEMINI_API_KEY, gpt-4o-mini with OPENAI_API_KEY)
AI_MODEL=
