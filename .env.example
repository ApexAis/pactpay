# ==============================================================================
# PactPay — Environment Configuration Template
# Copy this file to .env and fill in your PayPal Sandbox and optional AI keys.
# All PayPal endpoints strictly target the PayPal Developer Sandbox environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# PayPal Developer Platform (Sandbox Only)
# Create a free Sandbox REST App at: https://developer.paypal.com/dashboard/applications/sandbox
# Note: If left empty, PactPay automatically runs with a deterministic PayPal
# Sandbox REST protocol simulator so demos and tests work out of the box.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# AI Contract Compiler & Deliverable Auditor Configuration (Optional)
# Provide either a Google Gemini API key or an OpenAI/Groq-compatible API key.
# Note: If no AI key is provided, PactPay uses its built-in AST + heuristic
# deterministic AI engine so all features work offline/without external keys.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Local open-weight model instead (no key, no cost): ollama pull gpt-oss:20b, then
# OPENAI_API_KEY=ollama  OPENAI_BASE_URL=http://localhost:11434/v1  AI_MODEL=gpt-oss:20b
AI_MODEL=gemini-2.5-flash
